# Database
DATABASE_URL="postgresql://user:password@localhost:5432/renderforge"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# Redis (for BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# S3-compatible storage (AWS S3 or Cloudflare R2)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="renderforge-models"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI Service Providers (configure at least one)
AI_PROVIDER="meshy"

# Meshy AI
MESHY_API_KEY=""

# Stability AI (TripoSR)
STABILITY_API_KEY=""

# OpenAI (Point-E / Shap-E)
OPENAI_API_KEY=""

# Kie.ai (unified AI API gateway — image enhancement + 3D via fallback)
KIE_API_KEY=""
KIE_FALLBACK_PROVIDER="meshy"  # Which 3D provider Kie.ai delegates to
